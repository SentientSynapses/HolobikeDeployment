{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.holobike.local/HolobikeDeployment/Schemas/profiles.schema.json",
  "title": "Profile",
  "description": "A named composition of integrations: which components a bundle carries. Topology — where components run, which simulated ports replace hardware — arrives as this kind grows; membership comes first because assemble needs it first.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "integrations"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "The profile's name; also its file name under Profiles/."
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "uroborOS",
          "HexAtlas",
          "Assetscape",
          "HolobikeCore",
          "AthleteIdentity",
          "drAIs",
          "HolobikeExperience",
          "HolobikeDevice",
          "HolobikeRider",
          "HolobikeWorlds"
        ]
      }
    },
    "topology": {
      "type": "object",
      "description": "How emulate runs each member: keys must be members of this profile's integrations (the binding enforces the subset), values declare the run mode and a non-secret environment overlay. host is the only mode today; vm arrives with the promoted uroborOS validation surface.",
      "propertyNames": {
        "enum": [
          "uroborOS",
          "HexAtlas",
          "Assetscape",
          "HolobikeCore",
          "AthleteIdentity",
          "drAIs",
          "HolobikeExperience",
          "HolobikeDevice",
          "HolobikeRider",
          "HolobikeWorlds"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "run": { "enum": ["host"] },
          "environment": {
            "type": "object",
            "propertyNames": { "minLength": 1 },
            "additionalProperties": { "type": "string" }
          }
        }
      }
    }
  }
}
