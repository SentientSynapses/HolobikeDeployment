{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.holobike.local/HolobikeDeployment/Schemas/policy.schema.json",
  "title": "Policy document",
  "description": "Declared constraints, evaluated by resolve and carried as verdicts on every resolution record. A failed gate annotates the record; only admission refuses on it — records state facts, gates gate promotion. tree_parity compares one integration's subtree against another's, file for file by digest, with excluded path components declared rather than assumed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy", "gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "policy": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "The policy's name; also its file name under Policy/."
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/gate" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "left", "right"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "kind": { "enum": ["tree_parity"] },
        "left": { "$ref": "#/$defs/site" },
        "right": { "$ref": "#/$defs/site" },
        "exclude": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!\\.{1,2}$)[^/\\u0000]+$",
            "description": "A path component name, excluded wherever it appears in either tree."
          }
        }
      }
    },
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["integration", "path"],
      "properties": {
        "integration": {
          "enum": [
            "uroborOS",
            "HexAtlas",
            "Assetscape",
            "HolobikeCore",
            "AthleteIdentity",
            "drAIs",
            "HolobikeExperience",
            "HolobikeDevice",
            "HolobikeRider",
            "HolobikeWorlds"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*//)(?!.*(?:^|/)\\.(?:/|$))(?!.*\\u0000)(?!.*/$).+$",
          "description": "Relative to the integration's checkout root; never absolute, never escaping."
        }
      }
    }
  }
}
