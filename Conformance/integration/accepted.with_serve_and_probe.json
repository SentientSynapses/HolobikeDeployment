{
  "schema_version": 1,
  "integration": "AthleteIdentity",
  "domain": "id",
  "repository": "AthleteIdentity",
  "entry_points": {
    "serve": {
      "argv": ["${BUNDLE}/athleteidentity_service", "--profiles-root", "${STATE}/profiles"],
      "env": { "ATHLETE_IDENTITY_KEY_PROVIDER": "filesystem" }
    },
    "probe": {
      "argv": ["${BUNDLE}/athleteidentity_cli", "auth", "health"]
    }
  }
}
