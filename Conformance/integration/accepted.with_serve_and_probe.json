{
  "schema_version": 2,
  "integration": "HexAtlas",
  "domain": "geo",
  "repository": "HexAtlas",
  "deployables": {
    "AtlasClient": {
      "destination": "device",
      "serve": {
        "argv": [
          "${BUNDLE}/atlas_service",
          "--endpoint",
          "./atlas.sock"
        ],
        "env": {
          "ATLAS_MODE": "emulated"
        }
      },
      "probe": {
        "argv": [
          "${BUNDLE}/atlas_cli",
          "probe"
        ]
      }
    }
  }
}
