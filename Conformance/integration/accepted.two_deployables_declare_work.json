{
  "schema_version": 2,
  "integration": "HexAtlas",
  "domain": "geo",
  "repository": "HexAtlas",
  "deployables": {
    "AtlasClient": {
      "destination": "device",
      "build": {
        "steps": [
          {
            "argv": [
              "cmake",
              "--build",
              "B"
            ]
          }
        ]
      },
      "artifacts": [
        "Builds/bin/atlas_client"
      ]
    },
    "AtlasServer": {
      "destination": "server",
      "build": {
        "steps": [
          {
            "argv": [
              "./build-image.sh"
            ]
          }
        ]
      },
      "artifacts": [
        "Builds/atlasserver-image.tar"
      ]
    }
  }
}
