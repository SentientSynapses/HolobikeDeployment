{
  "schema_version": 2,
  "integration": "drAIs",
  "domain": "ai",
  "repository": "drAIs",
  "origin": "git@github.com:Saga-Holographic/drAIs.git",
  "prove": {
    "argv": [
      "bash",
      "drais.sh",
      "eval",
      "all"
    ]
  },
  "deployables": {
    "DraisClient": {
      "destination": "device"
    },
    "DraisServer": {
      "destination": "server",
      "build": {
        "steps": [
          {
            "argv": [
              "bash",
              "drais.sh",
              "build"
            ]
          }
        ]
      },
      "artifacts": [
        "Builds/drAIs_ninja/drais_gateway"
      ]
    }
  }
}
