{
  "schema_version": 2,
  "integration": "HexAtlas",
  "domain": "geo",
  "repository": "HexAtlas",
  "origin": "git@github.com:Saga-Holographic/HexAtlas.git",
  "deployables": {
    "AtlasClient": {
      "destination": "device"
    },
    "AtlasServer": {
      "destination": "server",
      "build": {
        "steps": [
          {
            "argv": [
              "./AtlasServer/atlasserver.sh",
              "build",
              "hexatlasserver"
            ]
          }
        ]
      },
      "artifacts": [
        "Builds/HexAtlasServer_ninja/bin/HexAtlasServer"
      ]
    }
  }
}
