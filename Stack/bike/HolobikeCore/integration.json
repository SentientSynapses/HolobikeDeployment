{
  "schema_version": 2,
  "integration": "HolobikeCore",
  "domain": "bike",
  "repository": "HolobikeCore",
  "origin": "git@github.com:Saga-Holographic/HolobikeCore.git",
  "prove": {
    "argv": [
      "bash",
      "./holobikecore.sh",
      "prove"
    ]
  },
  "deployables": {
    "HolobikeCore": {
      "destination": "device",
      "build": {
        "steps": [
          {
            "argv": [
              "bash",
              "./holobikecore.sh",
              "package"
            ]
          }
        ]
      },
      "artifacts": [
        "Builds/HolobikeCore_linux/holobike-core-rootfs.tar"
      ]
    }
  }
}
